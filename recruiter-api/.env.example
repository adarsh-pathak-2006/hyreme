PORT=4000
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/hyreme
# Atlas direct-host example:
# MONGODB_URI=mongodb://USERNAME:PASSWORD@HOST-00-00.mongodb.net:27017,HOST-00-01.mongodb.net:27017,HOST-00-02.mongodb.net:27017/hyreme?ssl=true&replicaSet=YOUR_REPLICA_SET&authSource=admin&retryWrites=true&w=majority&appName=Cluster0
